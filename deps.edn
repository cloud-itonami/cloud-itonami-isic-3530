{:paths ["src"]
 ;; langgraph-clj brings langchain-clj transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM).
 ;; For monorepo workspace dev, uncomment :local/root and use :dev alias.
 ;; For standalone forks, use git coordinates to com-junkawasaki/langgraph-clj.
 :deps {io.github.com-junkawasaki/langgraph-clj
        {:git/url "https://github.com/com-junkawasaki/langgraph-clj.git"
         :git/sha "a332a770a0d2b5193f81b54483bb954fb29ef8d7"}
        ;; デジタル庁デザインシステム (DADS) -- this workspace's base design
        ;; system. Used only by `steam.render-html` to style the build-time
        ;; operator console; the actor itself has no UI dependency.
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}}
 :aliases
 {;; monorepo workspace dev -- pin both to local checkout
  :dev-local {:override-deps
              {io.github.com-junkawasaki/langgraph-clj
               {:local/root "../../kotoba-lang/langgraph"}}}
  ;; This alias held an :override-deps entry for the retired coordinate
  ;; io.github.com-junkawasaki/langchain-clj. langgraph declares the same
  ;; library as io.github.kotoba-lang/langchain, so the entry matched no
  ;; node in the resolved tree and never reached the classpath -- verified
  ;; with `clojure -Stree`/-Spath, unchanged before and after removal.
  :dev {}
  ;; clojure -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "steam.sim"]}
  ;; clojure -M:dev:render-html [out-file] -> regenerate
  ;; docs/samples/operator-console.html from the REAL actor stack
  ;; (flagship checklist item 2). Refuses to write a page whose ledger
  ;; contains no governor hold.
  :render-html {:main-opts ["-m" "steam.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
